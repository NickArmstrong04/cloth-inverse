# Slurm settings for cloth data generation on Bouchet (Yale YCRC).
# KEY=VALUE, sourced by the shell scripts and parsed by submit.py.
# Values here are defaults; submit.py flags override them.

# --- paths on the cluster ---
# Everything lives under the PI scratch space.
BASE_DIR=/home/naa79/scratch_pi_sz622/naa79
# CODE_DIR defaults to the transfer/ directory the scripts sit in (auto-detected);
# with the layout below that is $BASE_DIR/cloth-inverse/cloth_data_generation/transfer.
CODE_DIR=
# Per-sample HDF5 output (one subdirectory per dataset name).
DATA_DIR=/home/naa79/scratch_pi_sz622/naa79/cloth_data

# --- Slurm resources (Bouchet partitions as of 2026-10-27) ---
# gpu       : a40 / a5000 / l40s / rtx_5000_ada nodes     gpu_h100 / gpu_h200 : faster, long queues
# scavenge_gpu : preemptible access to every GPU; tasks are requeued and resume, so it is
#                safe for this workload and the best source of extra overnight throughput.
PARTITION=gpu
CPU_PARTITION=day
ACCOUNT=                      # empty = your default account
GPUS=1                        # any GPU type (256 samples fit every card); l40s:1 to pin
CPUS=4
MEM=24G
TIME=02:00:00                 # per array task; short tasks backfill better and lose little on preemption
                              # (40 samples at 256 with JOBS_PER_TASK=2 should fit well inside this)
MAX_CONCURRENT=40             # array throttle: at most this many tasks at once
JOBS_PER_TASK=2               # samples simulated concurrently on the task's GPU (util was ~55% single)
EXCLUDE_NODES=a1125u05n01   # GPU fails with "primary context" / uncorrectable ECC errors (2026-10-28)

# --- dataset defaults: the BENCH profile (README 3d) ---
# 256 grid: resolution cost in the inverse model is small (RESULTS.md) and a sample is ~9x
# cheaper than at 768. Sheet on a table under gravity, pushed by two pusher-like forces.
NX=256
MATERIAL=cloth                # cloth | paper (plastic creasing); --material overrides.
                              # Same seed0 + n for both materials = paired datasets.
SEED0=100000
CHUNK=40                      # samples per array task (set from the smoke test timing)
# Forwarded to generate_sample.py. --force-every-substep fixes the half-impulse
# buffer bug; add --deterministic for bit-exact labels (~10x slower).
SAMPLE_ARGS=--force-every-substep
# Forwarded to generate_batch.py: force-direction model and scenario.
# '' reproduces the legacy free-floating, uniform-direction datasets.
BATCH_ARGS=--loading pusher --table
